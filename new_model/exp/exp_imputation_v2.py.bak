                #     wind_speed = batch_env[:, 0].cpu().numpy()  # 风速 WS (索引0)
                #     wind_direction = batch_env[:, 1].cpu().numpy()  # 风向 WD (索引1)
                #     thermal_exp = batch_env[:, 4].cpu().numpy() if batch_env.shape[1] > 4 else np.zeros_like(temps)  # 热膨胀 TE (索引4)

                #     # 获取平均隐藏特征（按时间维度平均）
                #     # avg_features = hidden_states.mean(dim=1).cpu()
                    
                #     # 添加到全局数据
                #     global_features['train'].append(hidden_states['fused'])
                #     global_temps['train'].extend(temps)
                #     global_hums['train'].extend(humidity)
                #     global_labels['train'].extend(['train'] * len(temps))
                    
                #     # 处理温度分箱
                #     for j, temp in enumerate(temps):
                #         # 找到对应温度的箱
                #         bin_idx = None
                #         for k, (bin_min, bin_max) in enumerate(temp_bins):
                #             if bin_min <= temp < bin_max:
                #                 bin_idx = k
                #                 break
                        
                #         # 如果找到对应箱且箱未满，收集样本
                #         if bin_idx is not None and bin_idx not in completed_bins['train']:
                #             if len(train_binned_data[bin_idx]['data']) < samples_per_bin:
                #                 # 收集样本数据
                #                 train_binned_data[bin_idx]['data'].append(batch_x[j:j+1].cpu())

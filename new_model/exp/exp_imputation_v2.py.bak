        # # 收集数据的数据结构 - 只保留训练数据
        # train_binned_data = {i: {'data': [], 'temp': [], 'attn': [], 'features': [], 
        #                       'humidity': [], 'wind_speed': [], 'wind_direction': [], 
        #                       'thermal_exp': []} for i in range(len(temp_bins))}
        
        # # 已完成的温度区间 - 只保留训练数据
        # completed_bins = {'train': set()}
        
        # # 全局特征数据 - 只保留训练数据
        # global_features = {'train': []}
        # global_temps = {'train': []}
        # global_hums = {'train': []}
        # global_labels = {'train': []}
        
        # # 是否是最后一轮的标志
        # is_final_epoch = False

        for epoch in range(self.args.train_epochs):
            iter_count = 0
            train_loss = []

            self.model.train()
            epoch_time = time.time()
            
            # 检查是否是最后一轮（达到最大轮次或即将触发早停）
            # if epoch == self.args.train_epochs - 1 or (early_stopping.counter == self.args.patience - 1 and epoch > 0):
            #     is_final_epoch = True
            #     print(f"Final epoch detected ({epoch+1}). Will collect attention weights during training.")
            
            for i, (x,  batch_y, batch_x_mark, batch_y_mark) in enumerate(train_loader):
                # if batch_x.sum() == 0:
                #     continue
                iter_count += 1
                model_optim.zero_grad()

                x = x.float().to(self.device)
                batch_x_mark = batch_x_mark.float().to(self.device)
                batch_env = batch_y.float().to(self.device) if batch_y is not None else None
                # batch_x = inject_sensor_fault(x_time,
                #                             self.fault_config,
                #                             self.device
                #                         )
                # imputation origin data without noise
                batch_x = x
                B, S, T, N = batch_x.shape
                mask = torch.rand((B, S, T, N)).to(self.device)
                mask[mask <= self.args.mask_rate] = 0  # masked
                mask[mask > self.args.mask_rate] = 1  # remained
                inp = batch_x.masked_fill(mask == 0, 0)

                # # 在最后一轮收集注意力和特征

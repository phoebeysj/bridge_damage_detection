                #                 train_binned_data[bin_idx]['thermal_exp'].append(thermal_exp[j])
                                
                #                 # 收集注意力权重
                #                 if isinstance(attention_weights, dict):
                #                     # 字典类型的注意力权重
                #                     attn_dict = {}
                #                     for attn_type, attn_val in attention_weights.items():
                #                         if attn_val is not None:
                #                             attn_dict[attn_type] = attn_val[j:j+1].cpu()
                #                     train_binned_data[bin_idx]['attn'].append(attn_dict)
                #                 else:
                #                     # 张量类型的注意力权重
                #                     train_binned_data[bin_idx]['attn'].append(attention_weights[j:j+1].cpu())
                                
                #                 # 收集隐藏特征
                #                 # train_binned_data[bin_idx]['features'].append(hidden_states['fused'][j:j+1])
                                
                #                 # 检查箱是否已满
                #                 if len(train_binned_data[bin_idx]['data']) >= samples_per_bin:
                #                     completed_bins['train'].add(bin_idx)
                # else:
                # 正常训练过程
                outputs, hidden_states, attention_weights = self.model.forward_with_attention(batch_x, batch_x_mark, None, None, mask, batch_env)
                loss = criterion(outputs.reshape(B, S*T, N), batch_x.reshape(B, S*T, N)) # 输入最好是(batch_size, time_steps, sensor_type) 输出就是(sensor_type) #  对比的是原始的x和重构输出的x
                train_loss.append(loss) 

                if (i + 1) % 200 == 0:
                    print("\titers: {0}, epoch: {1} | loss: {2:.7f}".format(i + 1, epoch + 1, loss.mean().item()))
                    speed = (time.time() - time_now) / iter_count
                    left_time = speed * ((self.args.train_epochs - epoch) * train_steps - i)
                    print('\tspeed: {:.4f}s/iter; left time: {:.4f}s'.format(speed, left_time))
                    iter_count = 0
                    
                loss.mean().backward() # 针对多变量的情况,做平均loss的下降
                model_optim.step()
            train_loss = torch.stack(train_loss, dim=0)
            train_loss_mean, train_loss_std = percentile_cal(train_loss,per_num = 90)
            epoch_train_mean.append(train_loss_mean)
            epoch_train_std.append(train_loss_std)
            print("Epoch: {} cost time: {}".format(epoch + 1, time.time() - epoch_time))

            # # p_t = time.time()
            # print("start validate!")
            # vali_loss = self.vali(vali_data, vali_loader, criterion_vali, path_vali_loss_save) ## 返回一个列表(sample_length, feature_nums)

            # vali_loss_mean, vali_loss_std = percentile_cal(vali_loss, per_num = 90)
            # epoch_vali_mean.append(vali_loss_mean)
            # epoch_vali_std.append(vali_loss_std)

            # print("Epoch: {0}, Steps: {1} | Train Loss mean : {2} Vali Loss mean: {3}, Vali loss percentile 90 : {4} ".format(
            #     epoch + 1, train_steps, train_loss_mean, vali_loss_mean, vali_loss_std))

            # self.vali_loss_mean, self.vali_loss_std = early_stopping(vali_loss_mean, vali_loss_std, self.model, path, vali_loss)
            
            # # 如果是最后一轮，只收集训练数据
            # if is_final_epoch:
            #     print(f"Collecting training data in final epoch...")
                
            #     # 保存所有收集的训练数据
            #     print("Saving collected attention weights and features...")
                
            #     # 只保存训练数据 - 修改为使用类方法
            #     self.save_binned_data(train_binned_data, 'train', temp_bins, attn_weights_path)
                
            #     # 保存全局训练数据
            #     if global_features['train']:
            #         # 合并特征
            #         features_tensor = torch.cat(global_features['train'], dim=0)
                    
            #         global_save_data = {
            #             'features': features_tensor,
            #             'temperature': np.array(global_temps['train']),
            #             'humidity': np.array(global_hums['train']),
            #             'dataset_type': 'train',
            #             'labels': global_labels['train']
            #         }
                    
            #         global_feature_path = os.path.join(latent_features_path, 'global_train_features.pt')
            #         torch.save(global_save_data, global_feature_path)
                
            #     # 不进行可视化，只收集数据
            #     print("Training data collection completed at epoch {}!".format(epoch+1))

            print("start validate!")
            vali_loss = self.vali(val_data, val_loader, criterion_vali, path_vali_loss_save) ## 返回一个列表(sample_length, feature_nums)

            vali_loss_mean, vali_loss_std = percentile_cal(vali_loss, per_num = 90)
            epoch_vali_mean.append(vali_loss_mean)
            epoch_vali_std.append(vali_loss_std)

            print("Epoch: {0}, Steps: {1} | Train Loss mean : {2} Vali Loss mean: {3}, Vali loss percentile 90 : {4} ".format(
                epoch + 1, train_steps, train_loss_mean, vali_loss_mean, vali_loss_std))

            self.vali_loss_mean, self.vali_loss_std = early_stopping(vali_loss_mean, vali_loss_std, self.model, path, vali_loss)
            
            # 恢复训练模式
            self.model.train()
            
            if early_stopping.early_stop:
                print("Early stopping")

                break

            adjust_learning_rate(model_optim, epoch + 1, self.args)
        plot_loss(epoch_train_std, epoch_vali_std, None, None, path_train, self.args.patience, loss_type='mean')
        plot_loss(epoch_train_std, epoch_vali_std, None, None, path_train, self.args.patience, loss_type='std')
        
        # plot_loss(None, None, epoch_test_health_std, epoch_test_std, path_train, self.args.patience, loss_type='mean')
        # plot_loss(None, None,  epoch_test_health_std, epoch_test_std, path_train,self.args.patience, loss_type='std')
        print("epoch train vali loss plotted!")

        best_model_path = path + '/' + 'checkpoint.pth'
        checkpoint = torch.load(best_model_path)
        self.model.load_state_dict(checkpoint['model_state_dict'])
        # print('train done! start visualizing features...')

        # # 创建t-SNE可视化保存目录
        # tsne_save_path = os.path.join(path_train, 'tsne_visualization')
        # os.makedirs(tsne_save_path, exist_ok=True)

        # # 使用训练集和验证集进行特征可视化
        # print('Generating t-SNE visualization of training features...')

class Dataset_ETT_hour(Dataset):
    def __init__(self, args, root_path, flag='train', size=None,
                 features='S', data_path='ETTh1.csv',
                 target='OT', scale=True, timeenc=0, freq='h', seasonal_patterns=None):
        # size [seq_len, label_len, pred_len]
        self.args = args
        # info
        if size == None:
            self.seq_len = 24 * 4 * 4
            self.label_len = 24 * 4
            self.pred_len = 24 * 4
        else:
            self.seq_len = size[0]
            self.label_len = size[1]
            self.pred_len = size[2]
        # init
        assert flag in ['train', 'test', 'val']
        type_map = {'train': 0, 'val': 1, 'test': 2}
        self.set_type = type_map[flag]

        self.features = features
        self.target = target
        self.scale = scale
        self.timeenc = timeenc
        self.freq = freq

        self.root_path = root_path
        self.data_path = data_path
        self.__read_data__()

    def __read_data__(self):
        self.scaler = StandardScaler()
        df_raw = pd.read_csv(os.path.join(self.root_path,
                                          self.data_path))

        border1s = [0, 12 * 30 * 24 - self.seq_len, 12 * 30 * 24 + 4 * 30 * 24 - self.seq_len]
        border2s = [12 * 30 * 24, 12 * 30 * 24 + 4 * 30 * 24, 12 * 30 * 24 + 8 * 30 * 24]
        border1 = border1s[self.set_type]
        border2 = border2s[self.set_type]

        if self.features == 'M' or self.features == 'MS':
            cols_data = df_raw.columns[1:]
            df_data = df_raw[cols_data]
        elif self.features == 'S':
            df_data = df_raw[[self.target]]

        if self.scale:
            train_data = df_data[border1s[0]:border2s[0]]
            self.scaler.fit(train_data.values)
            data = self.scaler.transform(df_data.values)
        else:
            data = df_data.values

        df_stamp = df_raw[['date']][border1:border2]
        df_stamp['date'] = pd.to_datetime(df_stamp.date)
        if self.timeenc == 0:
            df_stamp['month'] = df_stamp.date.apply(lambda row: row.month, 1)
            df_stamp['day'] = df_stamp.date.apply(lambda row: row.day, 1)
            df_stamp['weekday'] = df_stamp.date.apply(lambda row: row.weekday(), 1)
            df_stamp['hour'] = df_stamp.date.apply(lambda row: row.hour, 1)
            data_stamp = df_stamp.drop(['date'], 1).values
        elif self.timeenc == 1:
            data_stamp = time_features(pd.to_datetime(df_stamp['date'].values), freq=self.freq)
            data_stamp = data_stamp.transpose(1, 0) 

        self.data_x = data[border1:border2]
        self.data_y = data[border1:border2]

        if self.set_type == 0 and self.args.augmentation_ratio > 0:
            self.data_x, self.data_y, augmentation_tags = run_augmentation_single(self.data_x, self.data_y, self.args)

        self.data_stamp = data_stamp

    def __getitem__(self, index):
        s_begin = index
        s_end = s_begin + self.seq_len
        r_begin = s_end - self.label_len
        r_end = r_begin + self.label_len + self.pred_len

        seq_x = self.data_x[s_begin:s_end]
        seq_y = self.data_y[r_begin:r_end]
        seq_x_mark = self.data_stamp[s_begin:s_end]
        seq_y_mark = self.data_stamp[r_begin:r_end]

        return seq_x, seq_y, seq_x_mark, seq_y_mark

    def __len__(self):
        return len(self.data_x) - self.seq_len - self.pred_len + 1

    def inverse_transform(self, data):
        return self.scaler.inverse_transform(data)

class Z24loader(Dataset):
    def __init__(self, args, root_path, flag='train', size=None,
                 features='S', data_path='Z24.csv',
                 target='', scale=True, timeenc=0, freq='h', seasonal_patterns=None):
        self.args = args
        self.seq_len = args.seq_len
        self.label_len = 0
        self.pred_len = args.seq_len
        assert flag in ['train', 'test', 'val', 'test_health']
        type_map = {'train': 0, 'val': 1, 'test_health': 2, 'test': 3}
        self.set_type = type_map[flag]

        self.features = features
        self.target = target
        self.scale = scale
        self.timeenc = timeenc
        self.freq = freq
        self.root_path = root_path
        self.data_path = data_path
        self.flag = flag
        self.env_columns = ['WS', 'WD', 'H', 'AT', 'TE']
        
        # Define data paths
        self.train_data_path = 'data_six_months.parquet'
        self.train_env_path = 'env_data_final.parquet'
        self.test_health_data_path = 'data_test_health0.parquet'
        self.test_damage_data_path = 'data_test_damage0.parquet'
        self.test_env_path = 'data_test_env.parquet'
        
        # Initialize scaler
        self.scaler = MinMaxScaler(feature_range=(-1, 1))
        
        # Path for saving scaler parameters
        self.scaler_path = os.path.join(root_path, self.data_path, 'scaler_params.npz')
        
        self.__read_data__()

    def __read_data__(self):
        """Read and preprocess data based on flag."""
        # Handle scaler initialization/loading
        if self.scale:
            if self.flag == 'train' or not os.path.exists(self.scaler_path):
                # Only fit scaler on training data if we're in training mode or scaler params don't exist
                if self.args.sensors != 'all':
                    train_data = pd.read_parquet(
                        os.path.join(self.root_path, self.data_path, self.train_data_path),
                        columns=['datetime', self.args.sensors]
                    ).fillna(0)
                else:
                    train_data = pd.read_parquet(
                        os.path.join(self.root_path, self.data_path, self.train_data_path)
                    ).fillna(0)
                
                # Convert datetime to index
                train_data.set_index('datetime', inplace=True)
                
                # Fit scaler and save parameters
                self.scaler.fit(train_data.values)
                np.savez(self.scaler_path, 
                        scale_=self.scaler.scale_,
                        min_=self.scaler.min_,
                        data_min_=self.scaler.data_min_,
                        data_max_=self.scaler.data_max_,
                        data_range_=self.scaler.data_range_)
                
            if self.flag == 'train':
                    self.data_x = self.scaler.transform(train_data.iloc[0:10000,:].values)
                    self.timestamps = train_data.iloc[0:10000,:].index
                    self.data_env = pd.read_parquet(
                        os.path.join(self.root_path, self.data_path, self.train_env_path),columns=self.env_columns
                    ).fillna(0).iloc[0:100000,:]
                    print(f"Environment data index range: {self.data_env.index.min()} to {self.data_env.index.max()}")
                    print(f"Sensor data timestamp range: {self.timestamps.min()} to {self.timestamps.max()}")
                    return
            else:
                # Load saved scaler parameters
                scaler_params = np.load(self.scaler_path)
                self.scaler.scale_ = scaler_params['scale_']
                self.scaler.min_ = scaler_params['min_']
                self.scaler.data_min_ = scaler_params['data_min_']
                self.scaler.data_max_ = scaler_params['data_max_']
                self.scaler.data_range_ = scaler_params['data_range_']

        # Load and process data based on flag
        if self.flag == 'train':
            if not self.scale:  # If scale=True, this was handled above
                train_data = pd.read_parquet(
                    os.path.join(self.root_path, self.data_path, self.train_data_path),
                    columns=['datetime', self.args.sensors] if self.args.sensors != 'all' else None
                ).fillna(0)
                train_data.set_index('datetime', inplace=True)
                self.data_x = train_data.iloc[0:10000,:].values
                self.timestamps = train_data.iloc[0:10000,:].index
            
            self.data_env = pd.read_parquet(
                os.path.join(self.root_path, self.data_path, self.train_env_path),columns=self.env_columns
            ).fillna(0)
            print(f"Environment data index range: {self.data_env.index.min()} to {self.data_env.index.max()}")
            print(f"Sensor data timestamp range: {self.timestamps.min()} to {self.timestamps.max()}")

        elif self.flag == 'val':
            train_data = pd.read_parquet(
                os.path.join(self.root_path, self.data_path, self.train_data_path),
                columns=['datetime', self.args.sensors] if self.args.sensors != 'all' else None
            ).fillna(0)
            train_data.set_index('datetime', inplace=True)
            
            # Use last 30% of training data for validation
            val_start = int(len(train_data) * 0.7)
            val_data = train_data.iloc[val_start:].copy().iloc[0:10000,:]
            self.data_x = self.scaler.transform(val_data.values) if self.scale else val_data.values
            self.timestamps = val_data.index
            
            train_env = pd.read_parquet(
                os.path.join(self.root_path, self.data_path, self.train_env_path),columns=self.env_columns
            ).fillna(0)
            val_env_start = int(len(train_env) * 0.7)
            self.data_env = train_env.iloc[val_env_start:].iloc[0:10000,:]
            print('done!')
        elif self.flag == 'test_health':
            test_health_data = pd.read_parquet(
                os.path.join(self.root_path, self.data_path, self.test_health_data_path),
                columns=['datetime', self.args.sensors] if self.args.sensors != 'all' else None
            ).fillna(0)
            test_health_data.set_index('datetime', inplace=True)
            
            self.data_x = self.scaler.transform(test_health_data.iloc[0:10000,:].values) if self.scale else test_health_data.values
            self.timestamps = test_health_data.iloc[0:10000,:].index
            
            test_env = pd.read_parquet(
                os.path.join(self.root_path, self.data_path, self.test_env_path),columns=self.env_columns
            ).fillna(0)
            self.data_env = test_env[test_env.index < pd.to_datetime('1998-08-01')].iloc[0:10000,:]
            print('done!')
        elif self.flag == 'test':
            test_damage_data = pd.read_parquet(
                os.path.join(self.root_path, self.data_path, self.test_damage_data_path),
                columns=['datetime', self.args.sensors] if self.args.sensors != 'all' else None
            ).fillna(0)
            test_damage_data.set_index('datetime', inplace=True)
            
            self.data_x = self.scaler.transform(test_damage_data.iloc[0:10000,:].values) if self.scale else test_damage_data.values
            self.timestamps = test_damage_data.iloc[0:10000,:].index
            
            test_env = pd.read_parquet(
                os.path.join(self.root_path, self.data_path, self.test_env_path),columns=self.env_columns
            ).fillna(0)
            self.data_env = test_env[test_env.index > pd.to_datetime('1998-08-01')].iloc[0:10000,:]
            print('done!')
    def __getitem__(self, index):
        s_begin = index * self.seq_len  # 计算批次的起始位置
        s_end = s_begin + self.seq_len  # 计算批次的结束位置
        r_begin = s_begin
        r_end = s_end
        
        seq_x = self.data_x[s_begin:s_end]
        # 使用对应时间戳获取环境数据
        current_timestamp = self.timestamps[s_begin]
        # 找到最接近的时间戳
        closest_timestamp = pd.Timestamp(current_timestamp).floor('H')  # 向下取整到小时
        
        # 找到最接近的可用时间戳
        available_timestamps = self.data_env.index
        closest_available = available_timestamps[available_timestamps.searchsorted(closest_timestamp)]
        seq_env = torch.FloatTensor(self.data_env.loc[closest_available].values)  # 转换为PyTorch tensor
        
        # 将时间戳转换为数值特征
        timestamps = self.timestamps[s_begin:s_end]
        time_features = np.stack([
            timestamps.hour,
            timestamps.day,
            timestamps.dayofweek,
            timestamps.month,
        ], axis=1).astype(np.float32)
        seq_x_mark = torch.FloatTensor(time_features)
        seq_y_mark = torch.FloatTensor(timestamps.astype(np.int64).values) # 返回的是 数据、环境、时间特征、时间戳

        return seq_x, seq_env, seq_x_mark, seq_y_mark

    def __len__(self):
        return len(self.data_x) // self.seq_len

    def inverse_transform(self, data):
        return self.scaler.inverse_transform(data)